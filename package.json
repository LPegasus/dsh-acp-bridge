{
  "name": "@local/dsh-acp-bridge",
  "version": "0.3.1",
  "private": true,
  "description": "Use and manage ACP-compatible agents as DeepSeek Harness model providers.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js && node --check lib/acp-process.js && node --check lib/adapter.js && node --check lib/catalog.js && node --check lib/codex.js && node --check lib/config.js && node --check lib/projection.js && node --check lib/stream.js && node --check lib/updates.js && node --check lib/version.js",
    "probe:codex": "node scripts/probe-codex.js"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "2.8.0",
    "@agentclientprotocol/sdk": "2.8.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.5"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
